{
  "name": "clutch-policy",
  "author": "Gnosis Guild",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/gnosisguild/zodiac-constellation-template",
  "packageManager": "bun@1.3.0",
  "type": "module",
  "scripts": {
    "compile": "bun compiler/compile.ts --manifest manifests/fork-25946643.json",
    "check": "bun compiler/compile.ts --manifest manifests/fork-25946643.json --check",
    "test": "bun test compiler",
    "inspect": "bun .lib/scripts/inspect.ts",
    "format": "prettier --write .",
    "pull": "bun compiler/owner-guard.ts && zodiac pull",
    "pull-org": "bun compiler/owner-guard.ts && zodiac pull-org",
    "pull-contracts": "bun compiler/owner-guard.ts && zodiac pull-contracts",
    "prepush": "bun compiler/owner-guard.ts && zodiac pull-org",
    "push": "bun compiler/owner-guard.ts && bun ./.lib/scripts/push.ts"
  },
  "private": true,
  "description": "The Clutch permission policy as a Zodiac constellation, and its compiler",
  "dependencies": {
    "@zodiaceco/api-types": "1.9.0",
    "@zodiaceco/sdk": "2.1.2",
    "ethers": "6.17.0",
    "open": "11.0.1",
    "zodiac-roles-sdk": "4.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
