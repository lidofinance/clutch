# Copy to .env and fill. Never commit .env.
RPC=https://your-mainnet-rpc
PRIVATE_KEY=0x...          # dedicated throwaway executor EOA for the dry-run
FUNDER=0x...               # explicit funder (0.05 ETH) so balances, recipient and sweep agree
OPERATOR_STANDIN=0x...     # optional: separate throwaway for the TMC stand-in
EMERGENCY_STANDIN=0x...    # optional: separate throwaway for the EB stand-in
CONSTELLATION_SHA=02ea37d  # pinned lido-atm-constellation commit
