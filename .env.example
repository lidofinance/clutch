# Copy to .env and fill. Never commit .env.
RPC=https://your-archive-mainnet-rpc
PRIVATE_KEY=0x...          # dedicated throwaway executor EOA for the dry-run
FUNDER=0x...               # explicit funder (0.05 ETH) so balances, recipient and sweep agree
OPERATOR_STANDIN=0x...     # optional: separate throwaway that stands in for the operator Safe
EMERGENCY_STANDIN=0x...    # optional: separate throwaway that stands in for the emergency Safe
TECHNICAL_STANDIN=0x...    # optional: separate throwaway that stands in for the Emergency Brakes multisig
# After the dry-run deploy, from dryrun-manifest.json:
SAFE=0x...                 # the Asset Safe (fund, teardown)
AGENT=0x...                # the mock Agent (teardown)
ROLES=0x...                # the operator modifier (teardown)
SAFETY=0x...               # the safety modifier (teardown)
